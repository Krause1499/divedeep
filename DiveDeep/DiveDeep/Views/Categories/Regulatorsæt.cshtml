@{
    ViewData["Title"] = "Regulator";
}
@model List<Product>

<div class="row">
    @foreach (Product item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <a asp-area="" asp-controller="Products" asp-action="ProductInfo" asp-route-id="@item.Id"><img src="@item.FilePath" class="card-img-top" alt="test"></a>
                <div class="card-body">
                    <h5 class="card-title">@item.Brand</h5>
                    <h6 class="card-subtitle mb-2 text-muted">
                        1. trin: @item.Regulator.StageOne<br />
                        2. trin: @item.Regulator.StageTwo<br />
                        Octupus: @item.Regulator.Octopus
                    </h6>
                    <p class="card-text mb-2">@item.DailyPrice kr. pr. dag</p>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-area="" asp-controller="Products" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Rediger</a>
                        <a asp-area="" asp-controller="Products" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" onclick="return confirmDelete()">Slet</a>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function confirmDelete() {
            return confirm("Er du sikker på, at du vil slette dette produkt? Handlingen kan ikke fortrydes")
        }
    </script>
}