@model Order

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model.Items)
    {
        <div class="col card-col">
            <div class="card card-eq shadow-sm">
                <a asp-controller="Products" asp-action="ProductInfo" asp-route-id="@item.Id">
                    <img src="@item.FilePath" class="card-img-top" alt="produkt">
                </a>

                <div class="card-body">
                    @if (item.ProductType is ProductType.Regulator)
                    {
                        <h5 class="card-title mb-1">@item.Brand</h5>
                    }
                    else
                    {
                        <h5 class="card-title mb-1">@item.Model</h5>
                        <h6 class="card-subtitle text-muted mb-3">@item.Brand</h6>
                    }
                    <p class="mb-3">@item.Price kr. pr. dag</p>

                    <!-- Reserveret specs-område (samme højde på alle kort) -->
                    <div class="specs">
                        @* Vis kun det, der findes *@
                        @if (item.ProductType is ProductType.BCD || item.ProductType is ProductType.Fins || item.ProductType is ProductType.DivingSuit)
                        {
                            <div class="mb-2">
                                <div class="fw-semibold">Valgt størrelse:</div>
                                <span class="badge bg-primary">@item.Size</span>
                            </div>
                        }
                        @if (item.ProductType is ProductType.DivingSuit && item.Gender != null)
                        {
                            <div class="mb-2">
                                <div class="fw-semibold">Valgt køn:</div>
                                <span class="badge bg-secondary">@item.Gender</span>
                            </div>
                        }
                    </div>

                    <!-- Datoer skubbes ned mod bunden -->
                    <div class="dates">
                        <div class="row g-3 my-3">
                            <div class="col-6">
                                <label class="form-label mb-1">Startdato:</label>
                                <input asp-for="@item.StartDate" class="form-control" readonly />
                            </div>
                            <div class="col-6">
                                <label class="form-label mb-1">Slutdato:</label>
                                <input asp-for="@item.EndDate" class="form-control" readonly />
                            </div>
                        </div>

                        @if (User.IsInRole("Admin"))
                        {
                            <div class="d-flex gap-2">
                                <a asp-controller="Products" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Rediger</a>
                                <a asp-controller="Products" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger" onclick="return confirm('Er du sikker?')">Slet</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function confirmDelete() {
            return confirm("Er du sikker på, at du vil slette dette produkt? Handlingen kan ikke fortrydes")
        }
    </script>
}
