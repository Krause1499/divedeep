@model Product

@if (Model.ProductType == ProductType.BCD)
{
    <div class="mb-3">
        <label asp-for="BCD.Model" class="form-label">Model</label>
        <input asp-for="BCD.Model" class="form-control" />
        <span asp-validation-for="BCD.Model" class="text-danger"></span>
    </div>
}

